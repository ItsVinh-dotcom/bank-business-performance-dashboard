{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.12.0/schema.json",
  "name": "l1",
  "position": {
    "x": 20,
    "y": 420,
    "z": 0,
    "height": 280,
    "width": 1240,
    "tabOrder": 0
  },
  "visual": {
    "visualType": "lineChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "dim_month"
                    }
                  },
                  "Property": "month"
                }
              },
              "queryRef": "dim_month.month",
              "nativeQueryRef": "month",
              "active": true
            }
          ]
        },
        "Series": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "dim_branch"
                    }
                  },
                  "Property": "branch_name"
                }
              },
              "queryRef": "dim_branch.branch_name",
              "nativeQueryRef": "branch_name"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "fact_performance"
                    }
                  },
                  "Property": "Tỷ lệ HT dư nợ"
                }
              },
              "queryRef": "fact_performance.Tỷ lệ HT dư nợ",
              "nativeQueryRef": "Tỷ lệ HT dư nợ"
            }
          ]
        }
      }
    },
    "drillFilterOtherVisuals": true
  }
}