table fact_performance
	lineageTag: 9941c297-3e5f-4fa1-a4f4-65b5dd64ef1a

	measure 'Dư nợ kế hoạch' = SUM(fact_performance[plan_balance_bn])
		formatString: #,0
		displayFolder: 1. Kế hoạch vs thực tế
		lineageTag: 8c670f6e-7434-4699-bda0-1d45cd757934

	measure 'Dư nợ thực tế' = SUM(fact_performance[actual_balance_bn])
		formatString: #,0
		displayFolder: 1. Kế hoạch vs thực tế
		lineageTag: 71576cac-65fb-482e-9cbf-b6933e9456f0

	/// Tổng thực tế chia tổng kế hoạch (có trọng số). Ngưỡng: >=100% đạt, 95-100% cảnh báo, <95% đỏ.
	measure 'Tỷ lệ HT dư nợ' = DIVIDE([Dư nợ thực tế], [Dư nợ kế hoạch])
		formatString: 0.0%
		displayFolder: 1. Kế hoạch vs thực tế
		lineageTag: 879d1f74-0dfb-42f5-96c9-19620c2dbbce

	measure 'Chênh lệch dư nợ' = [Dư nợ thực tế] - [Dư nợ kế hoạch]
		formatString: #,0;-#,0
		displayFolder: 1. Kế hoạch vs thực tế
		lineageTag: af22f819-3be5-429d-b5c2-9ecdd9772363

	measure 'Doanh thu kế hoạch' = SUM(fact_performance[plan_revenue_mn])
		formatString: #,0
		displayFolder: 1. Kế hoạch vs thực tế
		lineageTag: 1d0235a3-b816-419e-89d2-664ec40f12b6

	measure 'Doanh thu thực tế' = SUM(fact_performance[actual_revenue_mn])
		formatString: #,0
		displayFolder: 1. Kế hoạch vs thực tế
		lineageTag: 1a31649e-5604-4e65-950f-9d38c9515704

	measure 'Tỷ lệ HT doanh thu' = DIVIDE([Doanh thu thực tế], [Doanh thu kế hoạch])
		formatString: 0.0%
		displayFolder: 1. Kế hoạch vs thực tế
		lineageTag: 15e89386-18f1-453e-b646-7383c77ef974

	measure 'Chênh lệch doanh thu' = [Doanh thu thực tế] - [Doanh thu kế hoạch]
		formatString: #,0;-#,0
		displayFolder: 1. Kế hoạch vs thực tế
		lineageTag: 7abc22f6-78b6-4c6b-8020-41ee0fe88cef

	measure 'KH mới kế hoạch' = SUM(fact_performance[plan_new_customers])
		formatString: #,0
		displayFolder: 1. Kế hoạch vs thực tế
		lineageTag: 034905bd-259b-447f-9df8-83bc7b9ccde9

	measure 'KH mới thực tế' = SUM(fact_performance[actual_new_customers])
		formatString: #,0
		displayFolder: 1. Kế hoạch vs thực tế
		lineageTag: 2a476013-2460-4b78-b775-90215a68eb01

	measure 'Tỷ lệ HT khách hàng mới' = DIVIDE([KH mới thực tế], [KH mới kế hoạch])
		formatString: 0.0%
		displayFolder: 1. Kế hoạch vs thực tế
		lineageTag: 51ae99c7-25ba-492c-b68c-8b1fd8bed03e

	/// DQ01: số dòng thiếu actual_revenue_mn. Mục tiêu bằng 0.
	measure 'Số dòng thiếu doanh thu' = COUNTROWS(FILTER(fact_performance, ISBLANK(fact_performance[actual_revenue_mn])))
		formatString: #,0
		displayFolder: 4. Chất lượng dữ liệu
		lineageTag: 8f477647-5ac6-41d9-8001-299bc98990dc

	/// DQ02: số dòng thừa so với khóa (tháng, chi nhánh, phân khúc, sản phẩm). Mục tiêu bằng 0.
	measure 'Số dòng trùng khóa' = COUNTROWS(fact_performance) - COUNTROWS(SUMMARIZE(fact_performance, fact_performance[month], fact_performance[branch_id], fact_performance[segment_id], fact_performance[product_id]))
		formatString: #,0
		displayFolder: 4. Chất lượng dữ liệu
		lineageTag: 491efba1-53cf-4f28-a995-34cea26791ea

