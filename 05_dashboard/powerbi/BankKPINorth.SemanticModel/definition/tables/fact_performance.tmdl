	partition fact_performance = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents("D:\03_career\Project\bank-business-performance-dashboard\02_data\north_provinces\fact_performance.csv"),[Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"month", type text}, {"branch_id", type text}, {"segment_id", type text}, {"product_id", type text}, {"plan_balance_bn", type number}, {"actual_balance_bn", type number}, {"plan_revenue_mn", type number}, {"actual_revenue_mn", type number}, {"plan_new_customers", Int64.Type}, {"actual_new_customers", Int64.Type}})
				in
