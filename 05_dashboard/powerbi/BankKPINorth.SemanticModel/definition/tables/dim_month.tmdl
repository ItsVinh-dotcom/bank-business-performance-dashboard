table dim_month
	lineageTag: 239ba1c0-bcb3-472f-b9ae-02f7d656a7ec

	column month
		dataType: string
		lineageTag: b442eb9e-5c6e-4132-a30a-f09659c24c74
		summarizeBy: none
		sourceColumn: month

	column year
		dataType: int64
		lineageTag: 42afb05c-fda9-4894-9a07-a268fb291a0f
		summarizeBy: none
		sourceColumn: year

	column month_num
		dataType: int64
		lineageTag: faf55d6d-f6c1-4d3c-ba31-0f6d82df84c5
